; Printer Inventory Agent configuration.
; This file lives next to printer_agent.exe and is read once, on service start
; (not hot-reloaded while running).

[server]
; Ingest endpoint of the accounting server (http:// works too).
url=https://accounting.example.com/api/agent-ingest
; The key of the "Агент принтеров" agent profile (Система -> Профили агентов,
; shown once; "новый ключ" issues another). It tells the server which profile
; to apply - there is no other server-side token.
auth_token=
; Number of the agent profile. Only needed for the WebSocket channel below.
profile_id=
timeout_ms=15000

[polling]
; Seconds between collection+send cycles. 3600 = once an hour. The server can
; override it from the profile settings ({"interval_seconds": N}).
interval_seconds=3600
; A printer only flips to "offline" in reports after this many consecutive
; bad cycles in a row (unreachable via SNMP, or Windows reports its queue as
; offline for local/USB) - a single blip doesn't count.
offline_after_consecutive_failures=3

[websocket]
; Optional live channel to the profile: the agent shows as "online" in the
; accounting UI (Профили агентов -> На связи), receives the profile settings
; and the "send report now" command. Needs Windows 8.1+; on Windows 7 the
; agent just keeps polling. The URL is derived from [server] url + profile_id
; unless set here explicitly:
;url=wss://accounting.example.com/api/agent-ws/<profile id>
enabled=false
; Reconnect pattern: retry every retry_interval_ms. After
; max_retries_before_relax consecutive failed attempts, back off for
; relax_delay_ms, then reset the counter and resume the fast retries. A
; connection that stays up 30+ seconds counts as success and resets the streak.
retry_interval_ms=2000
max_retries_before_relax=15
relax_delay_ms=60000

[snmp]
community=public
timeout_ms=2000
retries=3
retry_delay_ms=500
port=161

[discovery]
; Optional SNMP sweep for printers on the network that this PC has no print
; queue for (reported with portType "Network"). OFF by default: it sends an
; SNMP request to every address in the ranges each cycle, which an IDS may
; flag as a scan.
enabled=false
scan_local_subnets=true
;subnets=10.0.5.0/24, 10.0.7.20
min_prefix_length=22
max_hosts=4096
timeout_ms=1500
retries=2

[pjl]
; Optional highest-priority USB/local page-count source: sends a tiny raw PJL
; status query print job directly to the device and reads its own reply for
; the printer's TRUE lifetime page count (the WMI spooler counter below
; resets to 0 every time the Print Spooler service restarts, so it can never
; report that). OFF BY DEFAULT: a printer that does not understand PJL could
; print a garbled or blank page in response to this query, every collection
; cycle. Only turn this on after testing it once against your actual printer
; fleet and confirming (by watching the printer) that it does not misprint.
enabled=false
timeout_ms=5000

[logging]
; DEBUG, INFO, WARN, or ERROR
level=INFO
; Relative to the executable's directory unless an absolute path is given.
file=agent.log
max_size_kb=5120
max_files=5
